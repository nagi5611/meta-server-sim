# meta-server-sim 環境変数サンプル（コンテナ型プラットフォーム）
# cp .env.example .env して編集

PORT=3002
HOST=0.0.0.0

# FDS 煙バイナリ専用 HTTP（メインプロセスと分離。未設定時は PORT+1）
# FDS_SMOKE_BULK_PORT=3012
# FDS_SMOKE_BULK_DISABLE=1
# FDS_SMOKE_BULK_PUBLIC_ORIGIN=http://localhost:3012

# リバースプロキシ（手順は metaverse-simple/nginx/README.md と同形式）
# USE_REVERSE_PROXY=1
# TRUST_PROXY=1
# TRUST_PROXY は USE_REVERSE_PROXY=1 のときのみ有効（server.js の trust proxy と同条件）。
# 両方有効でない限り X-Forwarded-For は無視し socket の IP のみ使う（偽 XFF で管理トークン IP 拘束を bypass できない）。
# リバプロ配下では nginx 等が X-Forwarded-For を付与し、上記 2 変数を有効にすること。
# REQUIRE_SECURE_HTTP=1
#
# プラットフォーム入口（パスベース tenant は同一ドメインで /P-01/ 等）
# PROXY_DOMAIN_PORT_MAP=meta.mmh-virtual.jp=3000,sim.mmh-virtual.jp=3002,metair.mmh-virtual.jp=3001
# PROXY_SERVICE_DOMAIN=sim.mmh-virtual.jp
#
# 系列サーバー間ナビ（label|url を改行またはカンマ区切り）
# 管理パネル「ネットワーク / 系列リンク」または下記から編集可能
# 初回: cp data/platform/network-config.example.json data/platform/network-config.json
# METAVERSE_PORTAL_LINKS=みんなでメタ|http://localhost:3001,シミュレーション|http://localhost:3003
#
# Socket.io CORS（改行またはカンマ区切り）
# 本番（NODE_ENV=production）: 未設定だとクロスオリジン接続を拒否（列挙必須）
# 開発: 未設定時は http://localhost:PORT と http://localhost:VITE_DEV_PORT（既定 3002 / 3003）
# SOCKET_CORS_ORIGINS=https://sim.mmh-virtual.jp
#
# テナント HTTP/R2 署名・Socket 用 HMAC Cookie（metaverse_socket_auth）。本番では必ず固定の長い値を設定
# 未設定だとプロセス再起動で Cookie が無効になり、R2 署名 URL 取得に失敗しうる
# SOCKET_AUTH_SECRET=

# テナント Socket 接続の任意 join シークレット（全 tenant 共通。未設定時は誰でも接続可）
# テナント単位は tenants/<id>/tenant.json の socketSecret（設定時は .env より優先）
# ブラウザは ?join=<secret> で auth.joinToken を送る（docs/tenant-socket-join.md）
# TENANT_SOCKET_SECRET=

# 管理パネル環境変数の表示制御（.env のみ・管理パネルでは編集不可）
# ADMIN_ENV_SECRET_LEVEL=1
# ADMIN_ENV_MASK_KEYS=R2_SECRET_ACCESS_KEY,R2_ACCESS_KEY_ID,ADMIN_PASSWORD
#
# 管理パネルで設定した値は data/platform/env-config.json に保存されます。
# ADMIN_PASSWORD / R2 認証系は .env 専用（env-config.json には保存されません）。
# .env に同名キーがある場合は .env が優先され、管理パネルではロックされます。
# 任意: ENV_CONFIG_ENCRYPTION_KEY で非機密の env-config.json を暗号化保存

# HTTP レート制限を無効化（E2E・デバッグ用。本番では設定しない）
# HTTP_RATE_LIMIT_DISABLE=1

# 管理画面（/admin, /admin.html）Basic 認証
# ADMIN_USERNAME=admin
# 本番では 16 文字以上必須。開発では未設定時に data/platform/.admin-generated-password へ自動生成
# ADMIN_PASSWORD=
# 開発でも .admin-generated-password を使わず ADMIN_PASSWORD を必須にする: 1 / true / yes
# ADMIN_PASSWORD_REQUIRED=

# 新 tenant 作成: 管理パネル /admin.html の「Tenant 追加」、または POST /admin/tenants
# 手動の場合: tenants/_template をコピーしディレクトリ名と tenant.json の id を一致させる

# --- R2 オブジェクトストレージ（STORAGE_BACKEND=r2 時）---
# Cloudflare ダッシュボード → R2 → Manage R2 API Tokens で発行
# ブラウザ直アップロード/ダウンロードにはバケット CORS 設定が必要
# （AllowedMethods: GET, PUT, HEAD / ExposeHeaders: ETag）
# ブラウザ向けテナント静的配信はサーバー経由プロキシ（HEAD/CORS 対応）。
# presigned 直リンクは管理 API（r2-storage/download/url）のみ。
# STORAGE_BACKEND=local
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=metaverse-files
# R2_KEY_PREFIX=metaverse

# --- 音声・ビデオ VC（mediasoup）---
# VC_RTC_MIN_PORT=10000
# VC_RTC_MAX_PORT=10100
# VIDEO_VC_RTC_MIN_PORT=30000
# VIDEO_VC_RTC_MAX_PORT=31000
# VIDEO_VC_MAX_PRODUCERS_PER_ROOM=10
# CLOUDFLARE_TURN_API_TOKEN=
# CLOUDFLARE_TURN_KEY_ID=

# --- チャットモデレーション（Gemini）---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite-preview

# --- リアルタイム字幕（Google STT / Translate）---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# CAPTIONS_STT_LANGUAGE_CODE=ja-JP
# CAPTIONS_TRANSLATION_ENABLED=1
