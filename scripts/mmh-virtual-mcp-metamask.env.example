# /etc/mmh-virtual/mcp-metamask.env — Browser+MetaMask MCP on meta.mmh-virtual.jp (MetaSim)
METAMASK_EXTENSION_PATH=/home/nagi/sim-server/metamask-chrome-unpacked
BROWSER_METAMASK_BASE_URL=http://127.0.0.1:3004
# REQUIRE_SECURE_HTTP 時は loopback HTTP で mcp-wallet-smoke.html のみ許可（server.js）
BROWSER_METAMASK_USER_DATA_DIR=/home/nagi/sim-server/.data/mcp-metamask-profile
# Linux 本番で Google Chrome が無い場合は空にして Playwright bundled chromium を使用
BROWSER_METAMASK_CHANNEL=
MCP_SMOKE_TENANT_URL=https://sim.mmh-virtual.jp/P-01/
