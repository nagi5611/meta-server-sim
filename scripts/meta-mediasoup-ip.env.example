# /etc/mmh-virtual/meta-mediasoup-ip.env — root のみ (chmod 600)
# meta-server (port 3001): MEDIASOUP_ANNOUNCED_IP ← 自宅グローバル IPv4

METASIM_ENV_FILE=/home/nagi/meta-server/.env
METASIM_SERVICE=meta-server
METASIM_IPV4_URL=https://ipv4.icanhazip.com
MEDIASOUP_IP_SYNC_LABEL=meta

