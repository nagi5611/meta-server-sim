# /etc/mmh-virtual/metasim-mediasoup-ip.env — root のみ (chmod 600)
# mediasoup の MEDIASOUP_ANNOUNCED_IP を自宅グローバル IPv4 に同期（DNS/DDNS は使わない）

# meta-server-sim の .env
METASIM_ENV_FILE=/home/nagi/sim-server/meta-server-sim/.env

# 変更時に再起動する systemd ユニット
METASIM_SERVICE=metasim-server

# 公衆 IPv4 の取得 URL（応答 body が IPv4 のみ）
METASIM_IPV4_URL=https://ipv4.icanhazip.com

# 1 または true で .env / restart を行わずログのみ
# METASIM_MEDIASOUP_IP_DRY_RUN=0
