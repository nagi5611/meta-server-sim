# /etc/mmh-virtual/xserver-ddns.env — root のみ読める (chmod 600)
# cp xserver-ddns.env.example xserver-ddns.env して編集

# Xserver ドメイン API Bearer トークン（DNS レコード編集権限）
# 発行: https://developer.xserver.ne.jp/
XSERVER_API_TOKEN=

# mmh-virtual.jp の権威 DNS が ns*.xserver.jp のとき必須（レンタルサーバー API）
XSERVER_API_MODE=server
# サーバーパネル「サーバー情報」のサーバー名（例: xs123456.xsrv.jp）
XSERVER_SERVER_NAME=

# 対象ゾーン
# XSERVER_DNS_DOMAIN=mmh-virtual.jp

# 更新する A レコードのホスト名（カンマ区切り、@ は apex）
# MMH_DDNS_HOSTS=meta,metair,sim,metapre,metadogo,metaprehub

# 公開 IPv4 取得 URL（IPv4 明示）
# MMH_DDNS_IPV4_URL=https://ipv4.icanhazip.com
