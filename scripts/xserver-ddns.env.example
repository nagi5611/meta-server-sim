# /etc/mmh-virtual/xserver-ddns.env — root のみ (chmod 600)

XSERVER_API_TOKEN=

# 権威 DNS が Xserver レンタル (ns*.xserver.jp) のとき
XSERVER_API_MODE=server
# サーバーパネル「サーバー情報」のサーバーID（初期ドメイン）。例: buildtc.xsrv.jp
# ホスト名 sv16902.xserver.jp とは別（API の {servername} は *.xsrv.jp 側）
XSERVER_SERVER_NAME=buildtc.xsrv.jp

XSERVER_DNS_DOMAIN=mmh-virtual.jp
MMH_DDNS_HOSTS=meta,metair,sim,metapre,metadogo,metaprehub

# --- 学生（有料版）プラン等 ---
# 開発者画面で「APIでご利用いただけるサーバーがありません」→ Server API は使えない。
# Xserver ドメイン API だけでは ns*.xserver.jp の権威 DNS は更新されないことがある。
# その場合: サーバーパネル → DNSレコード設定 → mmh-virtual.jp → 各ホスト A を自宅 IP に手動更新。
# または API 対応プランへ変更後、本スクリプト (server モード) を再実行。
