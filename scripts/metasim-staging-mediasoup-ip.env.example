# /etc/mmh-virtual/metasim-staging-mediasoup-ip.env — root のみ (chmod 600)
# metasim-staging-server (port 3104): MEDIASOUP_ANNOUNCED_IP ← 自宅グローバル IPv4

METASIM_ENV_FILE=/home/nagi/sim-server/meta-server-sim-staging/.env
METASIM_SERVICE=metasim-staging-server
METASIM_IPV4_URL=https://ipv4.icanhazip.com
MEDIASOUP_IP_SYNC_LABEL=metasim-staging

