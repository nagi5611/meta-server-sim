{
    "name": "meta-server-sim",
    "version": "1.0.0",
    "description": "Metaverse simulation sibling server (series with metaverse-simple)",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "start:prod": "cross-env NODE_ENV=production node server.js",
        "dev:free-ports": "node scripts/free-dev-ports.mjs",
        "predev": "node scripts/free-dev-ports.mjs",
        "build:admin-world-edit-html": "node scripts/build-admin-tenant-world-edit-html.mjs",
        "dev": "concurrently -n node,vite,extra \"cross-env METAVERSE_DEV_NODEMON=1 nodemon server.js\" \"wait-on http://127.0.0.1:3002/api/health --timeout 30000 && cross-env VITE_DEV_PORT=3003 vite\" \"wait-on http://127.0.0.1:3002/api/health --timeout 30000 && node scripts/dev-extra-vite.mjs\"",
        "build": "vite build",
        "preview": "vite preview",
        "test:e2e": "playwright test",
        "test:e2e:tenant": "playwright test e2e/tenant-metaverse.spec.js",
        "test:e2e:world-edit": "playwright test e2e/tenant-world-edit.spec.js",
        "export:fds-smoke": "python scripts/export-fds-smoke.py"
    },
    "keywords": [
        "metaverse",
        "simulation",
        "socket.io"
    ],
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1121.0",
        "aws4fetch": "^1.0.20",
        "bootstrap-icons": "^1.13.1",
        "cross-env": "^7.0.3",
        "dotenv": "^17.2.3",
        "draco3dgltf": "^1.5.7",
        "express": "^4.18.2",
        "express-rate-limit": "^8.3.2",
        "fflate": "^0.8.3",
        "multer": "^2.3.0",
        "socket.io": "^4.7.2",
        "socket.io-client": "^4.8.1",
        "three": "^0.160.0",
        "three-mesh-bvh": "^0.9.3",
        "three-mesh-ui": "^6.5.4"
    },
    "devDependencies": {
        "@playwright/test": "^1.55.0",
        "concurrently": "^9.1.2",
        "nodemon": "^3.1.11",
        "vite": "^7.2.6",
        "wait-on": "^8.0.1"
    }
}
