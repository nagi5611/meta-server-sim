# Copy to .dev.vars (gitignored) for local Worker dev.
LOBBY_ADMIN_USER=admin
LOBBY_ADMIN_PASSWORD=change-me
LOBBY_ADMIN_SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LOBBY_SIM_SERVICE_TOKEN=unused-local

# Super-admin OTP 2FA (Worker secrets in production — never commit real values)
# Prefer SMS: ADMIN_PHONE (E.164 or domestic 0-prefix, e.g. +819012345678 or 090-1234-5678)
# ADMIN_PHONE=09012345678
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SNS_REGION=ap-northeast-1
# Email fallback when ADMIN_PHONE unset: ADMIN_EMAIL + RESEND_API_KEY
# ADMIN_EMAIL=you@example.com
# ADMIN_OTP_SECRET=optional-hmac-key-fallback-is-LOBBY_ADMIN_SESSION_SECRET
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=みんなでメタ <noreply@mmh-virtual.jp>

# Optional: announcement auto-translation (also: wrangler secret put GEMINI_TRANSLATION_API_KEY)
GEMINI_TRANSLATION_API_KEY=

# Optional: lobby join / profile display-name moderation (Jev). Do not reuse GEMINI_TRANSLATION_API_KEY.
# LOBBY_JEV_API_KEY=
# Or alias: JEV_API_KEY= / TYPESAFE_API_KEY=

# Optional: Google OAuth (scopes: openid email profile). LOBBY_JWT_SECRET required for /api/auth/google/start.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=   # never commit
# Fallback names: LOBBY_GOOGLE_CLIENT_ID / LOBBY_GOOGLE_CLIENT_SECRET / GOOGLE_OAUTH_*
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/api/auth/google/callback