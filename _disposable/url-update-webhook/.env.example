# 監視するページ（1 件）
WATCH_URL=https://example.com/

# 複数 URL（改行・カンマ区切り）。WATCH_URL も自動で含める
# WATCH_URLS=https://example.com/a/
# https://example.com/b.php?x=1

# Discord / Slack 等の Incoming Webhook URL
WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxx

# ポーリング間隔（ミリ秒、最小 5000）
INTERVAL_MS=60000

# 1=初回取得時も通知（既定 0=初回は通知しない）
# NOTIFY_ON_START=0

# Webhook に載せる文言
# NOTIFY_MESSAGE=更新されました
